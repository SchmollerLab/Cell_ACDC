include LICENSE

include cellacdc/resources/*
include cellacdc/bioformats/jars/*
include cellacdc/bioformats/tests/*
include cellacdc/metrics/*

exclude cellacdc/deprecated.py
exclude cellacdc/lastCommit.txt
exclude cellacdc/test.py
exclude cellacdc/test1.py
exclude cellacdc/test_qt_app.py
exclude cellacdc/temp/last_entries_metadata.csv
exclude cellacdc/temp/recentPaths.csv
exclude cellacdc/temp/segm_last_sel.csv
exclude cellacdc/temp/settings.csv

prune cellacdc/resources/figures
prune cellacdc/cellacdc.egg-info
prune cellacdc/utils/deprecated
prune cellacdc/docs/source/images
prune cellacdc/docs
# Read at runtime by rst_utils.get_tooltips_from_docs (GUI tooltips)
include cellacdc/docs/source/tooltips.rst

prune cellacdc/models/YeastMate/detectron2
prune cellacdc/models/YeastMate/pycocotools

prune .github
prune data
prune dist
prune tests
prune tables
prune publications
prune notebooks
prune UserManual
prune FijiMacros

exclude requirements.txt
exclude not_installed_requirements.txt
exclude requirements_new.txt
# Refactoring tools (not part of the package)
prune tools
